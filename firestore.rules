rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.createdAt is timestamp;
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['userId', 'title', 'start', 'end', 'createdAt']) &&
             data.keys().size() <= 12 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.start is timestamp &&
             data.end is timestamp &&
             data.createdAt is timestamp;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['userId', 'title', 'completed', 'createdAt']) &&
             data.keys().size() <= 10 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.completed is bool &&
             data.createdAt is timestamp;
    }

    function isValidNote(data) {
      return data.keys().hasAll(['userId', 'title', 'content', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // USERS
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
    }

    // EVENTS
    match /events/{eventId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidEvent(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidEvent(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'start', 'end', 'location', 'category', 'updatedAt']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // TASKS
    match /tasks/{taskId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidTask(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidTask(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'completed', 'dueDate', 'priority', 'updatedAt']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // NOTES
    match /notes/{noteId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidNote(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidNote(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'updatedAt']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
